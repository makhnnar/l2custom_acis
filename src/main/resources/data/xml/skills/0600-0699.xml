    <!-- create a reduce lvl version for the burn wind skill with only 10 lvls -->
    <!-- Burn Wind skill: hits the enemy with a powerful wind, inflicting continuous damage while the reg Hp and Cp is decreased -->
    <skill id="601" name="Burn Wind" levels="10">
        <table name="#mpConsume">40 41 43 43 44 45 47 48 49 51 52</table>
        <table name="#power">461 490 521 553 586 620 656 693 732 773</table>
        <!-- create a new dot table that starts at 76 and increases by 10 -->
        <table name="#dot">76 86 96 106 116 126 136 146 156 166</table>
        <!-- create a table for each reg hp and cp starting at 0.85 and decreasing by 0.05 each level-->
        <table name="#regPenalty"> 0.85 0.80 0.75 0.70 0.65 0.60 0.55 0.50 0.45 0.40</table>
        <set name="weaponsAllowed" val="POLE"/>
        <set name="mpConsume" val="#mpConsume"/>
        <set name="power" val="#power"/>
        <set name="target" val="AURA"/>
        <set name="skillRadius" val="350"/>
        <set name="overHit" val="true"/>
        <set name="ignoreShld" val="true"/>
        <set name="hitTime" val="1067"/>
        <set name="coolTime" val="733"/>
        <set name="effectRange" val="-1"/>
        <set name="castRange" val="-1"/>
        <set name="effectRange" val="-1"/>
        <set name="operateType" val="ACTIVE"/>
        <set name="nextActionAttack" val="true"/>
        <for>
            <effect count="20" name="DamOverTime" val="#dot" time="1">
                <mul order="0x30" stat="regHp" val="#regPenalty"/>
                <mul order="0x30" stat="regCp" val="#regPenalty"/>
            </effect>
        </for>
    </skill>

